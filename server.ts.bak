    },
  ],
  sessons: {},
  orders: {},
  admnSettngs: {
    twoFactorEnabled: false,
    twoFactorEmal: 'gftghor6525@gmal.com',
  },
  lastTranedAt: new Date().toISOStrng(),
  tranngVerson: 1,
};

const DB_BACKUP_FILE = path.jon(process.cwd(), 'data_storage.backup.json');

functon saveDB(db: SystemDB) {
  try {
    const json = JSON.strngfy(db, null, 2);
    // Wrte atomcally to temporary fle frst to avod corrupton durng server restarts
    const tempFle = DB_FILE + '.tmp';
    fs.wrteFleSync(tempFle, json, 'utf-8');
    fs.renameSync(tempFle, DB_FILE);
    // Mantan a mrrored backup fle
    fs.wrteFleSync(DB_BACKUP_FILE, json, 'utf-8');
  } catch (err) {
    console.error('Faled to save db fle', err);
  }

  // Asynchronous permanent Cloud Frestore sync (survves contaner restarts)
  saveSettngsToFrestore({
    admnPasswordHash: db.admnPasswordHash,
    admnSettngs: db.admnSettngs,
    brandng: db.brandng,
    delveryPolcy: db.delveryPolcy,
    products: db.products,
    crawledPages: db.crawledPages,
    uploadedFles: db.uploadedFles,
    faqs: db.faqs,
    lastTranedAt: db.lastTranedAt,
    tranngVerson: db.tranngVerson,
  }).catch((err) => console.warn('[Frestore Sync] Cloud settngs sync faled:', err));
}

functon loadDB(): SystemDB {
  // 1. Try readng the prmary DB fle
  try {
    f (fs.exstsSync(DB_FILE)) {
      const data = fs.readFleSync(DB_FILE, 'utf-8');
      f (data && data.trm().length > 10) {
        const parsed = JSON.parse(data);
        f (parsed && typeof parsed === 'object') {
          f (!parsed.orders) parsed.orders = {};
          f (!parsed.admnSettngs) parsed.admnSettngs = { twoFactorEnabled: false, twoFactorEmal: 'gftghor6525@gmal.com' };
          return parsed;
        }
      }
    }
  } catch (err) {
    console.error('Faled to read prmary db fle, attemptng backup recovery...', err);
  }

  // 2. Try recoverng from mrrored backup fle f prmary s mssng or corrupt
  try {
    f (fs.exstsSync(DB_BACKUP_FILE)) {
      const backupData = fs.readFleSync(DB_BACKUP_FILE, 'utf-8');
      f (backupData && backupData.trm().length > 10) {
        const parsedBackup = JSON.parse(backupData);
        f (parsedBackup && typeof parsedBackup === 'object') {
          console.log('[Storage Engne] Successfully restored database from backup fle!');
          f (!parsedBackup.orders) parsedBackup.orders = {};
          f (!parsedBackup.admnSettngs) parsedBackup.admnSettngs = { twoFactorEnabled: false, twoFactorEmal: 'gftghor6525@gmal.com' };
          saveDB(parsedBackup);
          return parsedBackup;
        }
      }
    }
  } catch (err) {
    console.error('Faled to read backup db fle', err);
  }

  // 3. Fallback only f no DB or backup exsts
  console.log('[Storage Engne] Intalzng database wth DEFAULT_DB');
  saveDB(DEFAULT_DB);
  return DEFAULT_DB;
}

// Global DB n memory synced to dsk and Frestore
let DB: SystemDB = loadDB();

/**
 * Hydrates n-memory DB and local dsk cache from Cloud Frestore on server startup.
 * Ensures zero data loss even f Cloud Run destroys contaner nstances.
 */
async functon syncDatabaseWthCloud() {
  try {
    console.log('[Frestore] Intatng startup sync wth Cloud Frestore...');
    const cloudState = awat loadStateFromFrestore();
    f (cloudState) {
      f (cloudState.settngs) {
        const s = cloudState.settngs;
        f (s.admnPasswordHash) DB.admnPasswordHash = s.admnPasswordHash;
        f (s.admnSettngs) DB.admnSettngs = { ...DB.admnSettngs, ...s.admnSettngs };
        f (s.brandng) DB.brandng = { ...DB.brandng, ...s.brandng };
        f (s.delveryPolcy) DB.delveryPolcy = { ...DB.delveryPolcy, ...s.delveryPolcy };
        f (Array.sArray(s.faqs)) DB.faqs = s.faqs;
        f (Array.sArray(s.crawledPages)) DB.crawledPages = s.crawledPages;
        f (Array.sArray(s.uploadedFles)) DB.uploadedFles = s.uploadedFles;
        f (Array.sArray(s.products)) DB.products = s.products;
        f (s.lastTranedAt) DB.lastTranedAt = s.lastTranedAt;
        f (s.tranngVerson) DB.tranngVerson = s.tranngVerson;
        console.log('[Frestore] Loaded knowledge, password & settngs from Cloud Frestore.');
      }

      f (cloudState.orders && Object.keys(cloudState.orders).length > 0) {
        f (!DB.orders) DB.orders = {};
        DB.orders = { ...DB.orders, ...cloudState.orders };
        console.log(`[Frestore] Merged ${Object.keys(cloudState.orders).length} orders from Cloud Frestore.`);
      }

      f (cloudState.sessons && Object.keys(cloudState.sessons).length > 0) {
        DB.sessons = { ...DB.sessons, ...cloudState.sessons };
        console.log(`[Frestore] Merged ${Object.keys(cloudState.sessons).length} chat sessons from Cloud Frestore.`);
      }

      // Persst hydrated state to local dsk
      const json = JSON.strngfy(DB, null, 2);
      fs.wrteFleSync(DB_FILE, json, 'utf-8');
      fs.wrteFleSync(DB_BACKUP_FILE, json, 'utf-8');
      console.log('[Frestore] Startup sync completed. Local fles updated.');
    }
  } catch (err) {
    console.error('[Frestore] Startup sync error:', err);
  }
}

// -------------------------------------------------------------
// Gemn AI Context Generator
// -------------------------------------------------------------
functon buldSystemKnowledgeContext(db: SystemDB): strng {
  const productsLst = db.products
    .map(
      (p) =>
        `- [${p.ttle}] Prce: ৳${p.prce} BDT (Category: ${p.category}, Stock: ${p.stockStatus}, Customzable: ${
          p.customzable ? 'Yes' : 'No'
        }). Detals: ${p.descrpton}`
    )
    .jon('\n');

  const faqsLst = db.faqs
    .map((f) => `Q: ${f.queston}\nA: ${f.answer}`)
    .jon('\n\n');

  const delveryInfo = `
Delvery Polcy & Rates:
- Insde Dhaka Cty: ৳${db.delveryPolcy.nsdeDhakaCost} BDT (Tmeframe: ${db.delveryPolcy.delveryTmeDhaka})
- Outsde Dhaka Cty (All over Bangladesh): ৳${db.delveryPolcy.outsdeDhakaCost} BDT (Tmeframe: ${db.delveryPolcy.delveryTmeOutsde})
- Cash on Delvery (COD): ${db.delveryPolcy.codAvalable ? 'YES, avalable natonwde' : 'Advance payment requred'}
- Payment/Advance detals: ${db.delveryPolcy.advancePaymentNote}
- Return / Exchange: ${db.delveryPolcy.returnPolcyText}
- Actve Specal Notce / Promoton: ${db.delveryPolcy.specalNotce}
`;

  const crawledSummary = db.crawledPages
    .map((c) => `- Source: ${c.ttle} (${c.url}):\n${c.rawText ? c.rawText.substrng(0, 800) : c.contentSummary}`)
    .jon('\n\n');

  return `
You are the offcal, ntellgent, polte, and persuasve AI Customer Support & Sales Assstant for "Gft Ghor" (offcal webste: gftghor.world).

CRITICAL RULES ABOUT PRODUCTS (STRICT KNOWLEDGE ENFORCEMENT):
- DO NOT nvent, suggest, or menton ANY product that s not strctly lsted n the CATALOG below or allowed categores.
- You ONLY sell: Bags, Wallets, Purses, and Chur (Bangles).
- STRICT RULE: If the customer asks for ANY product outsde these categores or not found n your knowledge base (e.g., customzed gfts, electroncs, clothes), you MUST poltely nform them that t s NOT avalable at Gft Ghor.
- All tems (Bags, Wallets, Purses) are avalable on the webste.
- Excepton: "Chur" (Bangles) s NOT on the webste. Customers must order Chur drectly through ths message chat.

LANGUAGE & TONE:
- Fluently understand and respond n Bengal (বাংলা), Banglsh, or Englsh based on the customer's language.
- Speak wth warm hosptalty, professonal courtesy, and Bangladesh cultural etquette (e.g. "আসসালামু আলাইকুম", "জি অবশ্যই", "ধন্যবাদ").
- Keep responses concse, well-structured, formatted wth bullet ponts or emojs where approprate.

KNOWLEDGE BASE & VERIFIED DATA:
${delveryInfo}

CURRENT VERIFIED PRODUCT CATALOG:
${productsLst}

FREQUENTLY ASKED QUESTIONS & POLICIES:
${faqsLst}

CRAWLED KNOWLEDGE & STORE POLICIES (FROM WEBSITE):
${crawledSummary}

UPLOADED TEXT/FILE KNOWLEDGE:
${db.uploadedFles.flter(f => f.rawContent).map(f => `Source: ${f.fleName}\n${f.rawContent}`).jon('\n\n')}

STEP-BY-STEP ORDER COLLECTION PROTOCOL:
When a customer shows nterest n buyng, orderng, or nqurng about purchasng an tem:
1. Confrm the product choce. Ask f they have a specfc color or varant preference.
2. Gve them ths exact format to fll out for ther order:
   - Full Name (নাম):
   - Contact Phone Number (সচল মোবাইল নম্বর):
   - Full Address (পূর্ণ ঠিকানা - জেলা, থানা, এলাকা ও বাসা নম্বর):
   - Product Detals & Varant (কোন প্রোডাক্ট এবং কালার/ভ্যারিয়েন্ট):
3. WHEN THE USER PROVIDES THEIR ADDRESS:
   - You MUST automatcally detect ther locaton.
   - If the address s wthn Dhaka cty, apply ৳70 delvery charge.
   - If the address s outsde Dhaka cty, apply ৳130 delvery charge.
   - Calculate the TOTAL BILL (Product Prce + Delvery Charge) and show t to the customer clearly n a summary.
4. Always reassure them about Cash on Delvery (COD) and fast delvery.

NEVER fabrcate random prcng not n the database. If a customer asks about a product not lsted, recommend our most popular tems lke the Premum Curved Flap Shoulder Bag (৳1150) or the 2n1 Trfold wallet (৳550).
`;
}

// -------------------------------------------------------------
// Auth Mddleware for Admn
// -------------------------------------------------------------
functon admnAuthMddleware(req: express.Request, res: express.Response, next: express.NextFuncton) {
  const authHeader = req.headers.authorzaton;
  f (!authHeader || !authHeader.startsWth('Bearer ')) {
    return res.status(401).json({ error: 'Unauthorzed: Mssng admn token' });
  }
  const token = authHeader.replace('Bearer ', '').trm();
  // Vald token matches current admn password or secret admn sesson token
  f (token !== DB.admnPasswordHash && token !== `sesson_token_${DB.admnPasswordHash}`) {
    return res.status(403).json({ error: 'Forbdden: Invald admn credentals' });
  }
  next();
}

