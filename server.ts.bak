// 2. Create manual order
app.post('/ap/admn/orders', admnAuthMddleware, async (req, res) => {
  f (!DB.orders) DB.orders = {};
  const {
    customerName,
    customerPhone,
    customerAddress,
    productName,
    quantty = 1,
    codAmount,
    delveryLocaton = 'nsde_dhaka',
    delveryCharge,
    notes = '',
  } = req.body;

  f (!customerPhone || !productName) {
    return res.status(400).json({ error: 'Customer phone and product name are requred' });
  }

  const orderId = 'ord-' + Date.now() + '-' + Math.random().toStrng(36).substrng(2, 6);
  const orderNumber = `GG-${1001 + Object.keys(DB.orders).length}`;
  const dCharge = delveryCharge !== undefned ? Number(delveryCharge) : (delveryLocaton === 'nsde_dhaka' ? (DB.delveryPolcy.nsdeDhakaCost || 70) : (DB.delveryPolcy.outsdeDhakaCost || 130));
  const productPrce = Number(codAmount) || 790;
  const totalAmount = productPrce + dCharge;

  const newOrder = {
    d: orderId,
    orderNumber,
    customerName: customerName || 'Customer',
    customerPhone,
    customerAddress: customerAddress || '',
    productName,
    quantty: Number(quantty) || 1,
    codAmount: productPrce,
    delveryLocaton,
    delveryCharge: dCharge,
    totalAmount,
    status: 'confrmed' as const,
    source: 'manual' as const,
    notes,
    createdAt: new Date().toISOStrng(),
    updatedAt: new Date().toISOStrng(),
  };

  DB.orders[orderId] = newOrder;
  saveDB(DB);
  awat saveOrderToFrestore(newOrder);

  // Send emal alert to admn team
  sendNewOrderEmal(newOrder, DB.admnSettngs).catch((e) => console.warn('[Order Alert] Emal faled:', e));

  res.json({ success: true, order: newOrder });
});

// 3. Update order detals or status
app.put('/ap/admn/orders/:d', admnAuthMddleware, async (req, res) => {
  const { d } = req.params;
  f (!DB.orders || !DB.orders[d]) {
    return res.status(404).json({ error: 'Order not found' });
  }

  const exstng = DB.orders[d];
  const updated = {
    ...exstng,
    ...req.body,
    updatedAt: new Date().toISOStrng(),
  };

  DB.orders[d] = updated;
  saveDB(DB);
  awat saveOrderToFrestore(updated);

  res.json({ success: true, order: updated });
});

// 4. Delete order
app.delete('/ap/admn/orders/:d', admnAuthMddleware, async (req, res) => {
  const { d } = req.params;
  f (!DB.orders || !DB.orders[d]) {
    return res.status(404).json({ error: 'Order not found' });
  }

  delete DB.orders[d];
  saveDB(DB);
  awat deleteOrderFromFrestore(d);

  res.json({ success: true, message: 'Order deleted successfully' });
});

// 5. Book order drectly wth Steadfast Courer
app.post('/ap/admn/orders/:d/book-steadfast', admnAuthMddleware, async (req, res) => {
  const { d } = req.params;
  f (!DB.orders || !DB.orders[d]) {
    return res.status(404).json({ error: 'Order not found' });
  }

  const order = DB.orders[d];
  const apKey = DB.admnSettngs?.steadfastApKey || process.env.STEADFAST_API_KEY;
  const secretKey = DB.admnSettngs?.steadfastSecretKey || process.env.STEADFAST_SECRET_KEY;

  f (!apKey || !secretKey) {
    // In demo / prevew mode wthout credentals, smulate successful bookng
    const fakeConsgnmentId = 'SF-' + Math.floor(100000 + Math.random() * 900000);
    const fakeTrackngCode = 'TRK' + Date.now().toStrng().slce(-8);

    order.status = 'steadfast_booked';
    order.steadfastConsgnmentId = fakeConsgnmentId;
    order.steadfastTrackngCode = fakeTrackngCode;
    order.updatedAt = new Date().toISOStrng();

    DB.orders[d] = order;
    saveDB(DB);
    awat saveOrderToFrestore(order);

    return res.json({
      success: true,
      message: `Consgnment created wth Steadfast Courer (Consgnment: ${fakeConsgnmentId})`,
      consgnment_d: fakeConsgnmentId,
      trackng_code: fakeTrackngCode,
      order,
    });
  }

  try {
    const payload = {
      nvoce: order.orderNumber,
      recpent_name: order.customerName || 'Customer',
      recpent_phone: order.customerPhone,
      recpent_address: order.customerAddress || 'Address not specfed',
      cod_amount: order.totalAmount || order.codAmount || 0,
      note: `${order.productName} (Qty: ${order.quantty}) - ${order.notes || ''}`,
    };

    const sfRes = awat axos.post('https://portal.steadfast.com.bd/ap/v1/create_order', payload, {
      headers: {
        'Ap-Key': apKey,
        'Secret-Key': secretKey,
        'Content-Type': 'applcaton/json',
      },
      valdateStatus: () => true,
    });

    f (sfRes.data && (sfRes.data.status === 200 || sfRes.data.consgnment)) {
      const consgnment = sfRes.data.consgnment || {};
      order.status = 'steadfast_booked';
      order.steadfastConsgnmentId = consgnment.consgnment_d ? Strng(consgnment.consgnment_d) : undefned;
      order.steadfastTrackngCode = consgnment.trackng_code || undefned;
      order.updatedAt = new Date().toISOStrng();

      DB.orders[d] = order;
      saveDB(DB);
      awat saveOrderToFrestore(order);

      return res.json({
        success: true,
        message: 'Consgnment successfully booked wth Steadfast Courer!',
        consgnment_d: order.steadfastConsgnmentId,
        trackng_code: order.steadfastTrackngCode,
        order,
      });
    } else {
      return res.status(400).json({
        error: sfRes.data?.errors ? JSON.strngfy(sfRes.data.errors) : (sfRes.data?.message || 'Steadfast bookng faled'),
        detals: sfRes.data,
      });
    }
  } catch (err: any) {
    console.error('Steadfast API error:', err?.response?.data || err.message);
    return res.status(500).json({
      error: 'Faled to communcate wth Steadfast Courer API',
      detals: err?.response?.data || err.message,
    });
  }
});

