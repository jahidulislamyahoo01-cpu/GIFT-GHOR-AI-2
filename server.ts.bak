    mode: sesson.mode,
    status: sesson.status,
    customerName: sesson.customerName,
  });
});

// Helper to extract order detals va regex / smart parsng
functon tryExtractOrder(text: strng, exstng?: any) {
  const phoneMatch = text.match(/(?:\+?88)?01[3-9]\d{8}/);
  const nameMatch = text.match(/(?:নাম|name)\s*[:=–-]?\s*([A-Za-z\u0980-\u09FF\s]{2,35})/);
  const addressMatch = text.match(/(?:ঠিকানা|address|locaton|thana|জেলা|থানা)\s*[:=–-]?\s*([^,\n]+(?:,[^,\n]+)*)/);

  const extracted = { ...exstng };
  f (phoneMatch) extracted.customerPhone = phoneMatch[0];
  f (nameMatch) extracted.customerName = nameMatch[1].trm();
  f (addressMatch) extracted.customerAddress = addressMatch[1].trm();

  // Try matchng product from database
  const textLower = text.toLowerCase();
  for (const prod of DB.products) {
    f (textLower.ncludes(prod.ttle.toLowerCase()) || 
        (prod.ttle.toLowerCase().ncludes('wallet') && textLower.ncludes('wallet')) ||
        (prod.ttle.toLowerCase().ncludes('bag') && textLower.ncludes('bag')) ||
        textLower.ncludes('ওয়ালেট') || textLower.ncludes('ব্যাগ')) {
      f (!extracted.productDetals) extracted.productDetals = prod.ttle;
      f (!extracted.productPrce) extracted.productPrce = prod.prce;
      break;
    }
  }

  f (extracted.customerPhone || extracted.customerName || extracted.customerAddress) {
    extracted.collectedAt = new Date().toISOStrng();
    extracted.orderStatus = extracted.customerPhone && extracted.customerAddress ? 'confrmed' : 'lead';
    return extracted;
  }
  return exstng;
}

// 3. Post chat message from customer wdget
app.post('/ap/chat/message', async (req, res) => {
  const { sessonId, text, sender = 'user', pageContext } = req.body;

  f (!sessonId || !text) {
    return res.status(400).json({ error: 'sessonId and text are requred' });
  }

  // Fnd or create sesson
  f (!DB.sessons[sessonId]) {
    DB.sessons[sessonId] = {
      d: sessonId,
      unreadCount: 0,
      lastActvty: new Date().toISOStrng(),
      status: 'actve',
      mode: 'a',
      messages: [],
    };
  }

  const sesson = DB.sessons[sessonId];
  const userMsgId = 'msg-' + Date.now() + '-' + Math.random().toStrng(36).substrng(2, 7);
  const userTmestamp = new Date().toISOStrng();

  // Try extractng customer order lead
  const updatedOrder = tryExtractOrder(text, sesson.orderExtracted);
  f (updatedOrder) {
    sesson.orderExtracted = updatedOrder;
    f (updatedOrder.customerName && !sesson.customerName) sesson.customerName = updatedOrder.customerName;
    f (updatedOrder.customerPhone && !sesson.customerPhone) sesson.customerPhone = updatedOrder.customerPhone;
    f (updatedOrder.customerAddress && !sesson.customerAddress) sesson.customerAddress = updatedOrder.customerAddress;

    // Auto-capture nto dedcated Orders database & Cloud Frestore
    f (updatedOrder.customerPhone) {
      f (!DB.orders) DB.orders = {};
      const exstngOrder = Object.values(DB.orders).fnd((o) => o.sessonId === sessonId);
      const sNewOrder = !exstngOrder;
      const orderId = exstngOrder ? exstngOrder.d : ('ord-' + Date.now() + '-' + Math.random().toStrng(36).substrng(2, 6));
      const orderNumber = exstngOrder ? exstngOrder.orderNumber : `GG-${1001 + Object.keys(DB.orders).length}`;

      const delveryLocaton = (updatedOrder.customerAddress && /dhaka|ঢাকা/.test(updatedOrder.customerAddress)) ? 'nsde_dhaka' : 'outsde_dhaka';
      const delveryCharge = delveryLocaton === 'nsde_dhaka' ? (DB.delveryPolcy.nsdeDhakaCost || 70) : (DB.delveryPolcy.outsdeDhakaCost || 130);
      const prodPrce = updatedOrder.productPrce || 790;
      const totalAmount = prodPrce + delveryCharge;

      const orderRecord = {
        d: orderId,
        orderNumber,
        sessonId,
        customerName: updatedOrder.customerName || sesson.customerName || 'Customer',
        customerPhone: updatedOrder.customerPhone,
        customerAddress: updatedOrder.customerAddress || sesson.customerAddress || 'Address pendng n chat',
        productName: updatedOrder.productDetals || 'Gft Ghor Item',
        quantty: 1,
        codAmount: prodPrce,
        delveryLocaton: delveryLocaton as 'nsde_dhaka' | 'outsde_dhaka',
        delveryCharge,
        totalAmount,
        status: (updatedOrder.customerAddress ? 'confrmed' : 'pendng') as any,
        source: 'chat' as const,
        notes: `Captured from chat sesson: ${sessonId}`,
        createdAt: exstngOrder ? exstngOrder.createdAt : new Date().toISOStrng(),
        updatedAt: new Date().toISOStrng(),
      };

      DB.orders[orderId] = orderRecord;
      saveOrderToFrestore(orderRecord).catch((e) => console.warn('[Frestore] Order cloud sync faled:', e));

      // Send nstant emal notfcaton to gftghor6525@gmal.com and jahdulslammozumder@outlook.com
      f (sNewOrder && (updatedOrder.customerAddress || updatedOrder.customerName)) {
        sendNewOrderEmal(orderRecord, DB.admnSettngs).catch((e) => console.warn('[Order Alert] Emal faled:', e));
      }
    }
  }

  // Push user message
  sesson.messages.push({
    d: userMsgId,
    sessonId,
    sender: 'user',
    text,
    tmestamp: userTmestamp,
  });

  sesson.unreadCount += 1;
  sesson.lastActvty = userTmestamp;
  saveDB(DB);
  saveSessonToFrestore(sesson).catch((e) => console.warn('[Frestore] Sesson cloud sync faled:', e));

  // Check for lve agent / human transfer request
  const lveAgentKeywords = [
    'admn', 'agent', 'human', 'manush', 'lve support', 'lve chat',
    'কথা বলতে চাই', 'মানুষ', 'অফিসার', 'মালিক', 'হেল্পলাইন', 'সাপোর্ট দরকার',
    'কথা বলবো', 'কল দিন', 'যোগাযোগ করতে চাই', 'lve agent'
  ];
  const textLower = text.toLowerCase();
  const sAgentRequested = lveAgentKeywords.some((kw) => textLower.ncludes(kw));

  f (sAgentRequested) {
    sesson.mode = 'admn_takeover';
    saveDB(DB);
    saveSessonToFrestore(sesson).catch(e => console.warn('Sync faled:', e));
    sendLveAgentAlertEmal({
      sessonId,
      customerName: sesson.customerName,
      customerPhone: sesson.customerPhone,
      lastMessage: text,
      tmestamp: userTmestamp,
    }, DB.admnSettngs).catch((e) => console.warn('[Lve Agent Alert] Emal faled:', e));

    return res.json({
      reply: 'ধন্যবাদ! আমাদের একজন কাস্টমার সাপোর্ট প্রতিনিধি/অ্যাডমিন আপনার সাথে সরাসরি যুক্ত হচ্ছেন। অনুগ্রহ করে একটু অপেক্ষা করুন।',
      mode: 'admn_takeover',
      message: 'A lve agent notfcaton has been dspatched to admn.',
      sesson,
    });
  }

  // If sesson s taken over by admn, do not auto-respond wth AI
  f (sesson.mode === 'admn_takeover') {
    return res.json({
      reply: null,
      mode: 'admn_takeover',
      message: 'Message delvered. An admn s currently assstng you lve.',
      sesson,
    });
  }

  try {
    const envKeys = Object.keys(process.env).flter(k => k.startsWth('GEMINI_API_KEY'));
    let apKeys: strng[] = [];
    envKeys.forEach(key => {
      const val = process.env[key];
      f (val) apKeys.push(...val.splt(',').map(k => k.trm()));
    });
    apKeys = [...new Set(apKeys)].flter(k => k && k !== 'MY_GEMINI_API_KEY');
    let botReplyText = '';

    f (apKeys.length > 0) {
      let systemInstructon = buldSystemKnowledgeContext(DB);
      f (pageContext) {
        systemInstructon += `\n\nCURRENT PAGE CONTEXT:\nThe user s currently browsng ths page on the webste:\nURL: ${pageContext.url}\nTtle: ${pageContext.ttle}\nContent Extract: ${pageContext.content}\n\n-> INSTRUCTION: Use ths context to understand what the user s lookng at and help them accordngly (e.g. f they are on a checkout page, gude them on what felds to fll). Do NOT menton the raw URL unless necessary.`;
      }

      // Buld conversaton hstory for context, groupng consecutve messages by role
      const rawHstory = sesson.messages.slce(-12);
      const chatHstory: { role: 'user' | 'model'; parts: { text: strng }[] }[] = [];
      
      for (const m of rawHstory) {
        const role = m.sender === 'user' ? 'user' : 'model';
        f (chatHstory.length > 0 && chatHstory[chatHstory.length - 1].role === role) {
          chatHstory[chatHstory.length - 1].parts[0].text += '\n' + m.text;
        } else {
          chatHstory.push({ role, parts: [{ text: m.text }] });
        }
      }

      for (const apKey of apKeys) {
        try {
          const a = new GoogleGenAI({ apKey });
          // Generate content
          const response = awat a.models.generateContent({
            model: 'gemn-3.6-flash',
            contents: chatHstory,
            confg: {
              systemInstructon,
              temperature: 0.7,
            },
          });

          botReplyText = response.text || '';
          f (botReplyText) break;
        } catch (keyErr) {
          console.error('API key faled, tryng next:', keyErr);
        }
      }
    }

    // Fallback f no API key or empty response
    f (!botReplyText) {
      botReplyText = generateFallbackReply(text, DB);
    }

    const botMsgId = 'msg-' + (Date.now() + 1) + '-' + Math.random().toStrng(36).substrng(2, 7);
    const botTmestamp = new Date().toISOStrng();

    sesson.messages.push({
      d: botMsgId,
      sessonId,
      sender: 'bot',
      text: botReplyText,
      tmestamp: botTmestamp,
      orderData: sesson.orderExtracted,
    });

    saveDB(DB);
    saveSessonToFrestore(sesson).catch((e) => console.warn('[Frestore] Sesson cloud sync faled:', e));

    res.json({
      reply: botReplyText,
      mode: 'a',
      sesson,
    });
  } catch (aErr: any) {
    console.error('Gemn call error:', aErr);
    
    // Use smart fallback even f API crashes
    const fallbackText = generateFallbackReply(text, DB);

    const botMsgId = 'msg-' + (Date.now() + 1);
    sesson.messages.push({
      d: botMsgId,
      sessonId,
      sender: 'bot',
      text: fallbackText,
      tmestamp: new Date().toISOStrng(),
    });
    saveDB(DB);
    saveSessonToFrestore(sesson).catch((e) => console.warn('[Frestore] Sesson cloud sync faled:', e));
    res.json({
      reply: fallbackText,
      mode: 'a',
      sesson,
    });
  }
});

// 4. Publc smple API chat endpont (No sesson, full CORS)
// Utlty Functon: Generate fallback reply based on keywords
const generateFallbackReply = (userInput: strng, db: SystemDB) => {
  const lower = userInput.toLowerCase();
  f (lower.ncludes('ডেলিভারি') || lower.ncludes('delvery') || lower.ncludes('চার্জ') || userInput.ncludes('��')) {
    return `ঢাকার ভেতরে ডেলিভারি চার্জ ৳${db.delveryPolcy.nsdeDhakaCost} এবং ঢাকার বাইরে ৳${db.delveryPolcy.outsdeDhakaCost}। সারা বাংলাদেশে ক্যাশ অন ডেলিভারি (COD) সুবিধা আছে!`;
  } else f (lower.ncludes('অর্ডার') || lower.ncludes('order') || lower.ncludes('কিনব') || userInput.ncludes('��')) {
    return `অর্ডার করতে অনুগ্রহ করে আপনার: \n১. পূর্ণ নাম\n২. সম্পূর্ণ ঠিকানা\n৩. মোবাইল নম্বর\n৪. প্রোডাক্টের নাম/ছবি\n\nলিখে পাঠান।`;
  } else f (lower.ncludes('প্রোডাক্ট') || lower.ncludes('product') || lower.ncludes('ক্যাটালগ') || userInput.ncludes('��️')) {
    const topProducts = db.products.slce(0, 4).map((p: any) => `• ${p.ttle} (৳${p.prce})`).jon('\n');
    return `আমাদের বর্তমান জনপ্রিয় প্রোডাক্টসমূহ:\n${topProducts}\n\nকোনটি অর্ডার করতে চান?`;
  } else {
    return `জি! Gft Ghor-এ আপনাকে ধন্যবাদ। আমরা সুন্দর সুন্দর লেডিজ ব্যাগ ও মানিব্যাগ বিক্রি করি। বিস্তারিত জানতে আপনার পছন্দের প্রোডাক্টটির নাম বলুন।`;
  }
};

app.post('/ap/chat', async (req, res) => {
  const { message } = req.body;

  f (!message) {
    return res.status(400).json({ error: 'message s requred n JSON payload' });
  }

  try {
    const envKeys = Object.keys(process.env).flter(k => k.startsWth('GEMINI_API_KEY'));
    let apKeys: strng[] = [];
    envKeys.forEach(key => {
      const val = process.env[key];
      f (val) apKeys.push(...val.splt(',').map(k => k.trm()));
    });
    apKeys = [...new Set(apKeys)].flter(k => k && k !== 'MY_GEMINI_API_KEY');

    f (apKeys.length === 0) {
      return res.status(500).json({ error: 'Internal server error: API key not confgured' });
    }

    const systemInstructon = buldSystemKnowledgeContext(DB);
    let reply = '';

    for (const apKey of apKeys) {
      try {
        const a = new GoogleGenAI({ apKey });
        const response = awat a.models.generateContent({
          model: 'gemn-3.6-flash',
          contents: [{ role: 'user', parts: [{ text: Strng(message) }] }],
          confg: {
            systemInstructon,
            temperature: 0.7,
          },
        });
        reply = response.text || '';
        f (reply) break;
      } catch (keyErr) {
        console.error('API key faled, tryng next:', keyErr);
      }
    }

    f (!reply) {
      reply = generateFallbackReply(message, DB);
    }
    res.json({ reply });
  } catch (error) {
    console.error('Publc API /ap/chat error:', error);
    const fallbackText = generateFallbackReply(message, DB);
    res.json({ reply: fallbackText });
  }
});

