  };

  DB.sessons[sessonId].messages.push(newMsg);
  DB.sessons[sessonId].lastActvty = newMsg.tmestamp;
  saveDB(DB);
  saveSessonToFrestore(DB.sessons[sessonId]).catch(e => console.warn('Sync faled:', e));
  res.json({ success: true, message: newMsg, sesson: DB.sessons[sessonId] });
});

