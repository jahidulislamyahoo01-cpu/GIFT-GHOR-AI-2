app.post('/ap/admn/securty', admnAuthMddleware, (req, res) => {
  const { twoFactorEnabled, twoFactorEmal } = req.body;
  f (!DB.admnSettngs) {
    DB.admnSettngs = {
      twoFactorEnabled: false,
      twoFactorEmal: 'gftghor6525@gmal.com',
    };
  }

  f (typeof twoFactorEnabled === 'boolean') {
    DB.admnSettngs.twoFactorEnabled = twoFactorEnabled;
  }
  f (twoFactorEmal && typeof twoFactorEmal === 'strng') {
    DB.admnSettngs.twoFactorEmal = twoFactorEmal.trm();
  }

  saveDB(DB);
  res.json({
    success: true,
    message: `Two-Step Verfcaton ${DB.admnSettngs.twoFactorEnabled ? 'ENABLED' : 'DISABLED'} successfully!`,
    admnSettngs: DB.admnSettngs,
  });
});

// Change admn password (works permanently wth ANY password!)
app.post('/ap/admn/change-password', admnAuthMddleware, (req, res) => {
  const { currentPassword, newPassword } = req.body;
  f (currentPassword !== DB.admnPasswordHash) {
    return res.status(400).json({ error: 'Current password does not match' });
  }
  f (!newPassword || newPassword.trm().length < 4) {
    return res.status(400).json({ error: 'New password must be at least 4 characters' });
  }

  DB.admnPasswordHash = newPassword.trm();
  f (!DB.admnSettngs) {
    DB.admnSettngs = { twoFactorEnabled: false, twoFactorEmal: 'gftghor6525@gmal.com' };
  }
  DB.admnSettngs.lastPasswordChangedAt = new Date().toISOStrng();
  saveDB(DB);

  const newToken = `sesson_token_${DB.admnPasswordHash}`;
  res.json({
    success: true,
    token: newToken,
    message: 'Password updated successfully and saved to Cloud Frestore!',
  });
});

