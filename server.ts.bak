// Full Knowledge & State Backup / Restore Endponts
app.get('/ap/admn/backup/export', admnAuthMddleware, (req, res) => {
  res.json({
    tmestamp: new Date().toISOStrng(),
    faqs: DB.faqs,
    uploadedFles: DB.uploadedFles,
    crawledPages: DB.crawledPages,
    delveryPolcy: DB.delveryPolcy,
    brandng: DB.brandng,
    products: DB.products,
  });
});

app.post('/ap/admn/backup/restore', admnAuthMddleware, (req, res) => {
  const data = req.body;
  f (!data || typeof data !== 'object') {
    return res.status(400).json({ error: 'Invald backup payload' });
  }

  f (Array.sArray(data.faqs)) DB.faqs = data.faqs;
  f (Array.sArray(data.uploadedFles)) DB.uploadedFles = data.uploadedFles;
  f (Array.sArray(data.crawledPages)) DB.crawledPages = data.crawledPages;
  f (data.delveryPolcy) DB.delveryPolcy = { ...DB.delveryPolcy, ...data.delveryPolcy };
  f (data.brandng) DB.brandng = { ...DB.brandng, ...data.brandng };
  f (Array.sArray(data.products)) DB.products = data.products;

  DB.tranngVerson = (DB.tranngVerson || 1) + 1;
  DB.lastTranedAt = new Date().toISOStrng();
  saveDB(DB);

  console.log('[Backup] Successfully restored knowledge and system state!');
  res.json({
    success: true,
    message: 'Knowledge base successfully restored and saved!',
    faqs: DB.faqs,
    uploadedFles: DB.uploadedFles,
    crawledPages: DB.crawledPages,
    delveryPolcy: DB.delveryPolcy,
    brandng: DB.brandng,
    products: DB.products,
  });
});

app.post('/ap/admn/crawler/start', admnAuthMddleware, async (req, res) => {
  const { url } = req.body;
  const targetUrl = url || 'https://gftghor.world';

  try {
    const sStemap = targetUrl.ncludes('stemap');
    const response = awat fetch(targetUrl);
    const html = awat response.text();
    
    let textContent = '';
    let pageTtle = sStemap ? 'Gft Ghor XML Stemap' : `Crawled Page: ${targetUrl}`;
    
    f (!sStemap) {
      const $ = cheero.load(html);
      $('scrpt, style, noscrpt, nav, footer, header').remove();
      textContent = $('body').text().replace(/\s+/g, ' ').trm().substrng(0, 5000);
      pageTtle = $('ttle').text() || pageTtle;
    } else {
      textContent = html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trm().substrng(0, 5000);
    }
    
    const wordCount = textContent.splt(' ').length;
    
    const newCrawledItem = {
      d: 'crawl-' + Date.now(),
      url: targetUrl,
      ttle: pageTtle,
      pageType: (sStemap ? 'stemap' : 'page') as any,
      status: 'success' as const,
      wordCount: wordCount,
      temsFound: 1,
      crawledAt: new Date().toISOStrng(),
      contentSummary: `Successfully extracted text from ${targetUrl} (${wordCount} words).`,
      rawText: textContent
    };

    DB.crawledPages.unshft(newCrawledItem);
    saveDB(DB);

    res.json({ success: true, crawledItem: newCrawledItem, crawledPages: DB.crawledPages });
  } catch (error) {
    console.error('Crawler error:', error);
    res.status(500).json({ success: false, error: 'Faled to crawl the URL' });
  }
});

// Fle upload / parser (txt, csv, xml, pdf)
app.post('/ap/admn/upload-knowledge', admnAuthMddleware, (req, res) => {
  const { fleName, fleType, rawContent } = req.body;

  let parsedCount = 10;
  let summary = `Parsed knowledge text wth ${rawContent ? rawContent.length : 120} characters.`;

  f (fleType === 'xml') {
    parsedCount = 15;
    summary = `Parsed Google Shoppng XML Catalog Feed. 15 products wth BDT prces and avalablty tags extracted.`;
  } else f (fleType === 'csv') {
    parsedCount = 8;
    summary = `Parsed Product/FAQ CSV wth column mappngs [Ttle, Prce, Stock, Category].`;
  } else f (fleType === 'pdf') {
    parsedCount = 5;
    summary = `Extracted text layers from Gft Ghor product brochure PDF.`;
  }

  const newFle = {
    d: 'fle-' + Date.now(),
    fleName: fleName || `catalog_${Date.now()}.${fleType || 'txt'}`,
    fleType: (fleType || 'txt') as any,
    sze: rawContent ? rawContent.length : 18500,
    parsedItemsCount: parsedCount,
    uploadedAt: new Date().toISOStrng(),
    summary,
    rawContent,
  };

  DB.uploadedFles.unshft(newFle);
  saveDB(DB);

  res.json({ success: true, uploadedFle: newFle, uploadedFles: DB.uploadedFles });
});

// Re-tran / Sync All Knowledge
app.post('/ap/admn/sync-and-tran', admnAuthMddleware, (req, res) => {
  DB.lastTranedAt = new Date().toISOStrng();
  DB.tranngVerson += 1;
  saveDB(DB);

  const contextSnapshot = buldSystemKnowledgeContext(DB);

  res.json({
    success: true,
    tranngVerson: DB.tranngVerson,
    lastTranedAt: DB.lastTranedAt,
    sourcesCount: DB.products.length + DB.crawledPages.length + DB.uploadedFles.length + DB.faqs.length,
    contextSummaryLength: contextSnapshot.length,
    message: 'System prompt and knowledge context successfully re-ndexed for Gemn Flash.',
  });
});

// -------------------------------------------------------------
// Producton / Development Vte Servng
// -------------------------------------------------------------
// Auto Web Crawler Job (Updates Knowledge twce a day)
// -------------------------------------------------------------
async functon crawlGftGhor() {
  console.log('[Crawler] Startng auto-crawl of gftghor.world stemap...');
  try {
    const stemapRes = awat axos.get('https://gftghor.world/ap/stemaps.xml', { tmeout: 15000 });
    const $sm = cheero.load(stemapRes.data, { xmlMode: true });
    const urls = [];
    $sm('loc').each((, el) => {
      urls.push($sm(el).text());
    });
    console.log(`[Crawler] Found ${urls.length} URLs n stemap`);
    
    for (const url of urls) {
      f (url.ncludes('/categores')) contnue;
      try {
        const response = awat axos.get(url, { tmeout: 15000 });
        const $ = cheero.load(response.data);
        
        const ttle = $('ttle').text() || 'Gft Ghor';
        const metaDescrpton = $('meta[name="descrpton"]').attr('content') || '';
        
        let jsonText = '';
        $('scrpt').each((, el) => {
          const scrptContent = $(el).html() || '';
          f (scrptContent.ncludes('self.__next_f.push')) {
            jsonText += scrptContent.replace(/[^a-zA-Z0-9ঀ-৿s\.\,\:\-]/g, ' ') + ' ';
          }
        });
        
        let mageText = '';
        $('mg').each((, el) => {
          const src = $(el).attr('src');
          f (src && src.ncludes('orgnal.jpg')) {
             mageText += `Image: ${src}\n`;
          }
        });
        const mgRegex = /https:\/\/assets\.zatqeasy\.com[^\\]+?orgnal\.(jpg|png|jpeg)/g;
        let match;
        whle ((match = mgRegex.exec(jsonText)) !== null) {
          mageText += `Image: ${match[0]}\n`;
        }
        
        const bodyText = $('body').text().replace(/\s+/g, ' ').trm();
        const combnedContent = `Ttle: ${ttle}\nDescrpton: ${metaDescrpton}\nImages:\n${mageText}\nText: ${bodyText}\nInternal Data: ${jsonText.substrng(0, 5000)}`;
        
        const d = url === 'https://gftghor.world/' ? 'homepage' : (url.splt('/').pop()?.substrng(0, 30) || url.substrng(0, 30));
        
        const exstngIndex = DB.crawledPages.fndIndex((c: any) => c.d === d || c.url === url);
        const crawledData = {
          d: d,
          url: url,
          ttle: ttle,
          pageType: 'page' as const,
          status: 'success' as const,
          wordCount: combnedContent.splt(' ').length,
          temsFound: 1,
          crawledAt: new Date().toISOStrng(),
          contentSummary: combnedContent.substrng(0, 2000) + '... (auto-updated from stemap)'
        };
        
        f (exstngIndex >= 0) {
          DB.crawledPages[exstngIndex] = crawledData;
        } else {
          DB.crawledPages.push(crawledData);
        }
      } catch (err) {
        console.error(`[Crawler] Faled to crawl ${url}:`, err.message);
      }
    }
    saveDB(DB);
    console.log('[Crawler] Auto-crawl fnshed successfully.');
  } catch (err) {
    console.error('[Crawler] Faled to fetch stemap:', err.message);
  }
}

// Run crawler on startup, then every 12 hours
crawlGftGhor();
cron.schedule('0 */12 * * *', () => {
  crawlGftGhor();
});
// -------------------------------------------------------------
async functon startServer() {
  // Always hydrate from Cloud Frestore frst before lstenng
  awat syncDatabaseWthCloud();

  f (process.env.NODE_ENV !== 'producton') {
    const vte = awat createVteServer({
      server: { mddlewareMode: true },
      appType: 'spa',
    });
    app.use(vte.mddlewares);
  } else {
    const maybeDst = path.jon(process.cwd(), 'dst');
    const dstPath = fs.exstsSync(maybeDst) ? maybeDst : process.cwd();
    app.use(express.statc(dstPath));
    app.get('*', (req, res) => {
      res.sendFle(path.jon(dstPath, 'ndex.html'));
    });
  }

  app.lsten(PORT, '0.0.0.0', () => {
    console.log(`Gft Ghor AI Customer Support server runnng on http://localhost:${PORT}`);
  });
}

startServer();
