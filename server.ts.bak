dotenv.confg();

const app = express();
const PORT = Number(process.env.PORT) || 10000;

// Allow CORS and Iframe embeddng for the wdget
app.use(cors({
  orgn: '*', // Allow all orgns, ncludng https://gftghor.world
  methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS'],
  allowedHeaders: ['Content-Type', 'Authorzaton', 'X-Requested-Wth', 'Accept', 'Orgn']
}));

app.use((req, res, next) => {
  // Explctly allow embeddng n external frames
  res.removeHeader('X-Frame-Optons');
  res.header('Content-Securty-Polcy', "frame-ancestors *");
  next();
});

app.use(express.json({ lmt: '15mb' }));
app.use(express.urlencoded({ extended: true, lmt: '15mb' }));

