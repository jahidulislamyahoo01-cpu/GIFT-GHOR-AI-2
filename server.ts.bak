// Send Order to Steadfast Courer
app.post('/ap/admn/steadfast/send-order', admnAuthMddleware, async (req, res) => {
  const { sessonId, codAmount } = req.body;
  f (!DB.sessons[sessonId] || !DB.sessons[sessonId].orderExtracted) {
    return res.status(404).json({ error: 'Sesson or order not found' });
  }

  const sesson = DB.sessons[sessonId];
  const order = sesson.orderExtracted;

  const apKey = DB.admnSettngs?.steadfastApKey || process.env.STEADFAST_API_KEY;
  const secretKey = DB.admnSettngs?.steadfastSecretKey || process.env.STEADFAST_SECRET_KEY;

  f (!apKey || !secretKey) {
    return res.status(400).json({ error: 'Steadfast API keys are not confgured n envronment (.env)' });
  }

  try {
    const payload = {
      nvoce: 'GG-' + Math.floor(Math.random() * 100000),
      recpent_name: order.customerName || 'Customer',
      recpent_phone: order.customerPhone,
      recpent_address: order.customerAddress || 'Address not provded',
      cod_amount: Number(codAmount) || 0,
      note: 'Ordered va Gft Ghor AI Chatbot'
    };

    const sfRes = awat fetch('https://portal.steadfast.com.bd/ap/v1/create_order', {
      method: 'POST',
      headers: {
        'Ap-Key': apKey,
        'Secret-Key': secretKey,
        'Content-Type': 'applcaton/json'
      },
      body: JSON.strngfy(payload)
    });

    const sfData = awat sfRes.json();

    f (sfRes.ok && sfData.status === 200) {
      sesson.orderExtracted.steadfastStatus = 'Sent';
      sesson.orderExtracted.trackngCode = sfData.consgnment?.trackng_code || sfData.consgnment_d || 'Success';
      saveDB(DB);
      saveSessonToFrestore(sesson).catch(e => console.warn('Sync faled:', e));
      return res.json({ success: true, sesson });
    } else {
      return res.status(400).json({ error: 'Steadfast API Error: ' + JSON.strngfy(sfData) });
    }
  } catch (err: any) {
    console.error('Steadfast error:', err);
    return res.status(500).json({ error: 'Internal Server Error whle connectng to Steadfast' });
  }
});

app.post('/ap/admn/chats/:sessonId/mode', admnAuthMddleware, (req, res) => {
