// Add / Edt / Delete Products
app.post('/ap/admn/products', admnAuthMddleware, (req, res) => {
  const product = req.body;
  f (!product.d) {
    product.d = 'prod-' + Date.now();
    DB.products.unshft(product);
  } else {
    const dx = DB.products.fndIndex((p) => p.d === product.d);
    f (dx !== -1) {
      DB.products[dx] = product;
    } else {
      DB.products.unshft(product);
    }
  }
  saveDB(DB);
  res.json({ success: true, products: DB.products });
});

app.delete('/ap/admn/products/:d', admnAuthMddleware, (req, res) => {
  const { d } = req.params;
  DB.products = DB.products.flter((p) => p.d !== d);
  saveDB(DB);
  res.json({ success: true, products: DB.products });
});

