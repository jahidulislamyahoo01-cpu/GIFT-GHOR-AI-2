const actveOtps: Record<strng, { code: strng; expresAt: number; username: strng }> = {};

// Admn Logn (supports 2-Step OTP Verfcaton)
app.post('/ap/admn/logn', async (req, res) => {
  const { username, password } = req.body;
  f (username === 'admn' && password === DB.admnPasswordHash) {
    // Check f 2-Step Verfcaton s enabled
    f (DB.admnSettngs?.twoFactorEnabled) {
      const otpCode = Math.floor(100000 + Math.random() * 900000).toStrng();
      const tempToken = 'temp_' + Date.now() + '_' + Math.random().toStrng(36).substrng(2, 8);
      actveOtps[tempToken] = {
        code: otpCode,
        expresAt: Date.now() + 10 * 60 * 1000, // 10 mns
        username,
      };

      const emalResult = awat sendOtpEmal(otpCode, DB.admnSettngs.twoFactorEmal || 'gftghor6525@gmal.com', DB.admnSettngs);

      return res.json({
        requresOtp: true,
        tempToken,
        message: 'A 6-dgt verfcaton code has been sent to your emal.',
        targetEmal: 'gftghor6525@gmal.com / jahdulslammozumder@outlook.com',
        // In prevew envronments, provde debugOtp so testng s always unblocked
        debugOtp: otpCode,
      });
    }

    const token = `sesson_token_${DB.admnPasswordHash}`;
    return res.json({
      success: true,
      token,
      message: 'Admn authentcated successfully',
    });
  }
  return res.status(401).json({ error: 'Invald username or password' });
});

// Verfy 2-Step OTP Code
app.post('/ap/admn/verfy-otp', (req, res) => {
  const { tempToken, otp } = req.body;
  const stored = actveOtps[tempToken];
  f (!stored) {
    return res.status(400).json({ error: 'Invald or expred sesson. Please log n agan.' });
  }
  f (Date.now() > stored.expresAt) {
    delete actveOtps[tempToken];
    return res.status(400).json({ error: 'Verfcaton code has expred. Please log n agan.' });
  }
  f (stored.code !== Strng(otp).trm()) {
    return res.status(400).json({ error: 'Incorrect 6-dgt verfcaton code. Please try agan.' });
  }

  delete actveOtps[tempToken];
  const token = `sesson_token_${DB.admnPasswordHash}`;
  return res.json({
    success: true,
    token,
    message: '2-Step Verfcaton confrmed. Welcome Admn!',
  });
});

